-- Buton tıklama efekti
local function animateButton(button)
    local originalSize = button.Size
    local tweenInfo = TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    
    local scaleDown = TweenService:Create(button, tweenInfo, {
        Size = originalSize - UDim2.new(0.05, 0, 0.05, 0)
    })
    
    local scaleUp = TweenService:Create(button, tweenInfo, {
        Size = originalSize
    })
    
    scaleDown:Play()
    scaleDown.Completed:Connect(function()
        scaleUp:Play()
    end)
end

-- Health limit butonlarını güncelle
local function updateHealthButtons()
    if Configs.HealthLimit == 0 then
        button0.BackgroundColor3 = Color3.fromRGB(60, 200, 60)
        button1.BackgroundColor3 = Color3.fromRGB(100, 100, 100)
        healthLabel.Text = "Target Health: 0 (No Respawn)"
    else
        button0.BackgroundColor3 = Color3.fromRGB(100, 100, 100)
        button1.BackgroundColor3 = Color3.fromRGB(60, 200, 60)
        healthLabel.Text = "Target Health: 1 (Can Respawn)"
